{% extends "layout.njk" %}
{% import "macros.njk" as macros %}

{% block main %}
{% for instruction in instructionsToExport | sort(false, false, 'name') %}
pub mod {{ macros.escapeRustKeyword(instruction.name | snakeCase) }}_row;
{% endfor %}
{% if hasAnchorEvents %}
pub mod cpi_event_row;
{% endif %}

{% for instruction in instructionsToExport | sort(false, false, 'name') %}
pub use self::{{ macros.escapeRustKeyword(instruction.name | snakeCase) }}_row::*;
{% endfor %}
{% if hasAnchorEvents %}
pub use self::cpi_event_row::*;
{% endif %}

use super::{{ program.name | pascalCase }}Instruction;

pub struct {{ program.name | pascalCase }}InstructionsMigration;

impl carbon_core::clickhouse::Migration for {{ program.name | pascalCase }}InstructionsMigration {
    fn app(&self) -> &str {
        "{{ program.name | kebabCase }}"
    }
    fn name(&self) -> &str {
        "{{ program.name | snakeCase }}_instructions"
    }
    fn operations(&self) -> Vec<Box<dyn carbon_core::clickhouse::operations::Operation>> {
        vec![{% for instruction in instructionsToExport | sort(false, false, 'name') %}
            Box::new({{ instruction.name | pascalCase }}MigrationOperation),{% endfor %}{% if hasAnchorEvents %}
            Box::new(CpiEventMigrationOperation),{% endif %}
        ]
    }
}

pub enum {{ program.name | pascalCase }}InstructionRow {
{% for instruction in instructionsToExport | sort(false, false, 'name') %}    {{ instruction.name | pascalCase }}({{ instruction.name | pascalCase }}Row),
{% endfor %}{% if hasAnchorEvents %}    CpiEvent(CpiEventRow),
{% endif %}}

pub struct {{ program.name | pascalCase }}InstructionMetadata<'a>(
    pub &'a carbon_core::instruction::InstructionMetadata,
    pub &'a {{ program.name | pascalCase }}Instruction,
);

impl<'a> carbon_core::clickhouse::BatchInsert for {{ program.name | pascalCase }}InstructionMetadata<'a> {
    type Row = {{ program.name | pascalCase }}InstructionRow;

    fn batch_insert(&self, rows: &mut Vec<Self::Row>) -> carbon_core::error::CarbonResult<()> {
        let &Self(metadata, instruction) = self;

{% if (instructionsToExport | length == 0) and (not hasAnchorEvents) %}        let _ = (metadata, instruction, rows);
        unreachable!("BatchInsert called for program with no instruction row variants");
{% else %}        macro_rules! insert_branch {
            ($variant:ident, $row:ty) => {
                if let {{ program.name | pascalCase }}Instruction::$variant { data, accounts, .. } = instruction {
                    rows.push({{ program.name | pascalCase }}InstructionRow::$variant(
                        <$row>::try_from((
                            data.clone(),
                            metadata.clone(),
                            accounts.clone(),
                        ))?,
                    ));
                    return Ok(());
                }
            };
        }

{% for instruction in instructionsToExport | sort(false, false, 'name') %}        insert_branch!({{ instruction.name | pascalCase }}, {{ instruction.name | pascalCase }}Row);
{% endfor %}{% if hasAnchorEvents %}        insert_branch!(CpiEvent, CpiEventRow);
{% endif %}
        Ok(())
{% endif %}    }
}

#[async_trait::async_trait]
impl carbon_core::clickhouse::BatchCommit for {{ program.name | pascalCase }}InstructionRow {
    async fn batch_commit(
        client: &clickhouse::Client,
        rows: &[Self],
    ) -> carbon_core::error::CarbonResult<()> {
{% if (instructionsToExport | length == 0) and (not hasAnchorEvents) %}        let _ = (client, rows);
        unreachable!("BatchCommit called for program with no instruction row variants");
{% else %}        macro_rules! commit_branch {
            ($variant:ident, $row:ty) => {
                {
                    let branch_rows: Vec<$row> = rows
                        .iter()
                        .filter_map(|row| match row {
                            Self::$variant(row) => Some(row.clone()),
                            _ => None,
                        })
                        .collect();

                    if !branch_rows.is_empty() {
                        <$row as carbon_core::clickhouse::Insert>::insert(client, &branch_rows).await?;
                    }
                }
            };
        }

{% for instruction in instructionsToExport | sort(false, false, 'name') %}        commit_branch!({{ instruction.name | pascalCase }}, {{ instruction.name | pascalCase }}Row);
{% endfor %}{% if hasAnchorEvents %}        commit_branch!(CpiEvent, CpiEventRow);
{% endif %}
        Ok(())
{% endif %}    }
}
{% endblock %}
